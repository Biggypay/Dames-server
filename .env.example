# Render / production configuration. Never commit the real values in .env.
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Supabase validates the user access token before issuing a game-server token.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
# Server-only secret from Supabase dashboard. Never put this in Lovable or an iframe URL.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ALLOW_LEGACY_LOCAL_AUTH=false

# Replace with the exact production origins, separated by commas when needed.
ALLOWED_ORIGIN=https://mindspille.lovable.app
FRAME_ANCESTORS=https://mindspille.lovable.app
